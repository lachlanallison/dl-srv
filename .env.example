# dl-srv environment — copy to .env and adjust
# cp .env.example .env

# HTTP listen address (35778 = d-l-s-r-v on a phone keypad)
DL_SRV_ADDR=0.0.0.0:35778

# API bearer token (leave empty to auto-generate on first run)
DL_SRV_TOKEN=

# --- Paths (inside the container) ---
# Downloads use category subfolders: DOWNLOAD_DIR/<category>/
# e.g. category "movies" → /media/movies, "tv" → /media/tv
DOWNLOAD_DIR=/media
CONFIG_DIR=/config
WEB_DIST=/app/web/dist

# --- Host bind mounts (docker-compose only) ---
# TrueNAS — mirror the Jellyfin app layout (one folder per app, config/ inside):
#
#   /mnt/apps/jellyfin/config   ← Jellyfin (already on your system)
#   /mnt/apps/dl-srv/config     ← dl-srv config (config.json, tasks.db, bin/)
#   /mnt/tank/media             ← same media root Jellyfin uses (movies/, tv/, …)
#
HOST_MEDIA_PATH=/mnt/tank/media
HOST_CONFIG_PATH=/mnt/apps/dl-srv/config

# Local dev fallback:
# HOST_MEDIA_PATH=./data/downloads
# HOST_CONFIG_PATH=./config

# aria2 JSON-RPC (sidecar in Docker entrypoint)
ARIA2_RPC_URL=http://127.0.0.1:6800/jsonrpc
ARIA2_RPC_SECRET=dl-srv-secret
ARIA2_RPC_PORT=6800

# Binaries
YTDLP_PATH=yt-dlp
FFMPEG_PATH=ffmpeg

# Optional: RUST_LOG=info,dlsrv=debug
