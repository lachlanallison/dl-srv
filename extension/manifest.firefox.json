{
  "manifest_version": 3,
  "name": "dl-srv",
  "version": "1.0.3",
  "description": "Send browser downloads to your self-hosted dl-srv NAS (HTTP, torrents, and video sites).",
  "browser_specific_settings": {
    "gecko": {
      "id": "dl-srv@lachlanallison.com",
      "strict_min_version": "140.0",
      "homepage_url": "https://github.com/lachlanallison/dl-srv",
      "data_collection_permissions": {
        "required": ["browsingActivity", "websiteContent"]
      }
    },
    "gecko_android": {
      "strict_min_version": "142.0"
    }
  },
  "permissions": [
    "downloads",
    "storage",
    "contextMenus",
    "notifications",
    "alarms",
    "tabs",
    "webNavigation",
    "cookies"
  ],
  "host_permissions": ["<all_urls>"],
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'; connect-src http: https: data: blob:;"
  },
  "background": {
    "scripts": ["shared.js", "background.js"]
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "dl-srv"
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
