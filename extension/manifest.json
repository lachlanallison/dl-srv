{
  "manifest_version": 3,
  "name": "dl-srv",
  "version": "0.1.0",
  "description": "Send browser downloads to your dl-srv NAS",
  "browser_specific_settings": {
    "gecko": {
      "id": "dl-srv@local",
      "strict_min_version": "109.0"
    }
  },
  "permissions": ["downloads", "storage", "contextMenus", "notifications", "alarms", "tabs"],
  "host_permissions": ["<all_urls>"],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "dl-srv"
  },
  "options_page": "options.html",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
