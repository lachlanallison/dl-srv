{
  "manifest_version": 3,
  "name": "dl-srv",
  "version": "0.1.3",
  "description": "Send browser downloads to your dl-srv NAS",
  "permissions": ["downloads", "storage", "contextMenus", "notifications", "alarms", "tabs"],
  "host_permissions": ["<all_urls>"],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "dl-srv"
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
