{
  "manifest_version": 3,
  "name": "dl-srv",
  "version": "1.0.0",
  "description": "Send browser downloads to your self-hosted dl-srv NAS (HTTP, torrents, and video sites).",
  "permissions": ["downloads", "storage", "contextMenus", "notifications", "alarms", "tabs", "cookies"],
  "host_permissions": ["<all_urls>"],
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'; connect-src http: https: data: blob:;"
  },
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "dl-srv"
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
